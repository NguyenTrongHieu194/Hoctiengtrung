rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User specific collection: each user can only read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /data/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Health check & test connection
    match /test/{document=**} {
      allow read, write: if true;
    }

    // Public shared content (HSK levels, lessons, vocabulary, specialized terms)
    match /hskLevels/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /vocabulary/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /lessons/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /specializedVocabulary/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
